4. Fibonacci Series Without Recursion
#include <stdio.h>

int main() {
    int n, i;
    int a = 0, b = 1, c;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    printf("Fibonacci Series: ");

    for (i = 0; i < n; i++) {
        printf("%d ", a);
        c = a + b;
        a = b;
        b = c;
    }

    return 0;
}
INPUT:
Enter number of terms: 7
OUTPUT:
Fibonacci Series: 0 1 1 2 3 5 8




