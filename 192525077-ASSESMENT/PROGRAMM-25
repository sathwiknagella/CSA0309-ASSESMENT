25. Minimum Spanning Tree - Kruskal's Algorithm
#include <stdio.h>

#define MAX 100

struct Edge {
    int source;
    int destination;
    int weight;
};

int parent[MAX];

int find(int i) {
    while (parent[i] != i)
        i = parent[i];

    return i;
}

void unionSet(int i, int j) {
    int a = find(i);
    int b = find(j);

    parent[a] = b;
}

int main() {
    struct Edge edges[MAX], temp;
    int n, e, i, j;
    int count = 0, total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &e);

    printf("Enter source destination weight:\n");

    for (i = 0; i < e; i++) {
        scanf("%d %d %d",
              &edges[i].source,
              &edges[i].destination,
              &edges[i].weight);

        edges[i].source--;
        edges[i].destination--;
    }

    for (i = 0; i < e - 1; i++) {
        for (j = 0; j < e - i - 1; j++) {
            if (edges[j].weight > edges[j + 1].weight) {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }

    for (i = 0; i < n; i++)
        parent[i] = i;

    printf("Edges in Minimum Spanning Tree:\n");

    for (i = 0; i < e && count < n - 1; i++) {
        int u = edges[i].source;
        int v = edges[i].destination;

        if (find(u) != find(v)) {
            printf("%d - %d : %d\n",
                   u + 1, v + 1, edges[i].weight);

            total += edges[i].weight;
            unionSet(u, v);
            count++;
        }
    }

    printf("Minimum cost = %d\n", total);

    return 0;
}
INPUT:
Enter number of vertices: 4
Enter number of edges: 5
Enter source destination weight:
1 2 10
1 3 6
1 4 5
2 4 15
3 4 4
OUTPUT:
Edges in Minimum Spanning Tree:
3 - 4 : 4
1 - 4 : 5
1 - 2 : 10
Minimum cost = 19






