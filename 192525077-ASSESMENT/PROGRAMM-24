24. Minimum Spanning Tree - Prim's Algorithm
#include <stdio.h>

#define MAX 20
#define INF 99999

int main() {
    int graph[MAX][MAX];
    int selected[MAX] = {0};
    int n, i, j, edges = 0;
    int min, x = 0, y = 0;
    int total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);

            if (graph[i][j] == 0 && i != j)
                graph[i][j] = INF;
        }
    }

    selected[0] = 1;

    printf("Edges in Minimum Spanning Tree:\n");

    while (edges < n - 1) {
        min = INF;

        for (i = 0; i < n; i++) {
            if (selected[i]) {
                for (j = 0; j < n; j++) {
                    if (!selected[j] && graph[i][j] < min) {
                        min = graph[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        printf("%d - %d : %d\n", x + 1, y + 1, min);

        total += min;
        selected[y] = 1;
        edges++;
    }

    printf("Minimum cost = %d\n", total);

    return 0;
}
INPUT:
Enter number of vertices: 4
Enter weighted adjacency matrix:
0 10 6 5
10 0 0 15
6 0 0 4
5 15 4 0
OUTPUT:
Edges in Minimum Spanning Tree:
1 - 4 : 5
4 - 3 : 4
1 - 2 : 10
Minimum cost = 19




