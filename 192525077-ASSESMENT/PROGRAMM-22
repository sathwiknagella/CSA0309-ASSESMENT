22. Depth First Search (DFS)
#include <stdio.h>

#define MAX 20

int graph[MAX][MAX];
int visited[MAX];
int n;

void DFS(int vertex) {
    int i;

    visited[vertex] = 1;

    printf("%d ", vertex + 1);

    for (i = 0; i < n; i++) {
        if (graph[vertex][i] == 1 &&
            visited[i] == 0) {
            DFS(i);
        }
    }
}

int main() {
    int i, j, start;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    printf("DFS Traversal: ");

    DFS(start - 1);

    return 0;
}
INPUT:
Enter number of vertices: 4
Enter adjacency matrix:
