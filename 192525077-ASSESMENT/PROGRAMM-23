23. Dijkstra's Shortest Path Algorithm
#include <stdio.h>

#define MAX 20
#define INF 99999

int main() {
    int graph[MAX][MAX];
    int distance[MAX], visited[MAX];
    int n, source;
    int i, j, count, min, next;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");
    printf("Use 0 for no direct edge.\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);

            if (graph[i][j] == 0 && i != j)
                graph[i][j] = INF;
        }
    }

    printf("Enter source vertex: ");
    scanf("%d", &source);

    source--;

    for (i = 0; i < n; i++) {
        distance[i] = graph[source][i];
        visited[i] = 0;
    }

    distance[source] = 0;
    visited[source] = 1;

    for (count = 1; count < n; count++) {
        min = INF;
        next = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                next = i;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        for (i = 0; i < n; i++) {
            if (!visited[i] &&
                distance[next] + graph[next][i] < distance[i]) {

                distance[i] =
                    distance[next] + graph[next][i];
            }
        }
    }

    printf("\nShortest distances from vertex %d:\n",
           source + 1);

    for (i = 0; i < n; i++)
        printf("To %d = %d\n", i + 1, distance[i]);

    return 0;
}
INPUT:
Enter number of vertices: 4
Enter weighted adjacency matrix:
0 5 10 0
5 0 3 9
10 3 0 1
0 9 1 0
Enter source vertex: 1
OUTPUT:
Shortest distances from vertex 1:
To 1 = 0
To 2 = 5
To 3 = 8
To 4 = 9




